+	uint8_t pk[LC_DILITHIUM_PUBLICKEYBYTES];
+};
+
+/**
+ * @brief Dilithium signature
+ */
+struct lc_dilithium_87_sig {
+	uint8_t sig[LC_DILITHIUM_CRYPTO_BYTES];
+};

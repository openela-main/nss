+#endif
+
+//#define ret_t int __attribute__((warn_unused_result))
+
+#ifdef LC_DEBUG
+#define CKERROR_LOG                                                            \
+	_Pragma("GCC diagnostic push")                                         \
+		_Pragma("GCC diagnostic ignored \"-Wpedantic\"")               \
+			printf("Error %d at %s:%s:%u\n", ret, __FILE__,        \
+			       __FUNCTION__, __LINE__);                        \
+	_Pragma("GCC diagnostic pop")
+#else
+#define CKERROR_LOG
+#endif
+
+#define CKINT(x)                                                               \
+	{                                                                      \
+		ret = x;                                                       \
+		if (ret < 0) {                                                 \
+			CKERROR_LOG                                            \
+			goto out;                                              \
+		}                                                              \
+	}
+
+#define CKINT_LOG(x, ...)                                                      \
+	{                                                                      \
+		ret = x;                                                       \
+		if (ret < 0) {                                                 \
+			CKERROR_LOG                                            \
+			printf(__VA_ARGS__);                                   \
+			goto out;                                              \
+		}                                                              \
+	}
+
+#define CKNULL(v, r)                                                           \
+	{                                                                      \
+		if (!v) {                                                      \
+			ret = r;                                               \
+			CKERROR_LOG                                            \
+			goto out;                                              \
+		}                                                              \
+	}
+
+#define CKNULL_LOG(v, r, ...)                                                  \
+	{                                                                      \
+		if (!v) {                                                      \
+			printf(__VA_ARGS__);                                   \
+			ret = r;                                               \
+			CKERROR_LOG                                            \
+			goto out;                                              \
+		}                                                              \
+	}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* RET_CHECKERS_H */

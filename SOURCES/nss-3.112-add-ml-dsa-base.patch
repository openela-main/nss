+		return -EINVAL;
+
+	*time_since_epoch = (time64_t)(jiffies / HZ);
+
+	return 0;
+}
+
+#define LC_FIPS_RODATA_SECTION
+
+#elif (defined(LC_EFI_ENVIRONMENT))
+/******************************************************************************
+ * UEFI support
+ ******************************************************************************/
+
+/* POSIX Support */

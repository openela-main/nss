+		memcpy(_sk->sk, src_key, src_key_len);
+		sk->dilithium_type = LC_DILITHIUM_87;
+		return 0;
+#endif
+#ifdef LC_DILITHIUM_65_ENABLED
+	} else if (src_key_len == lc_dilithium_sk_size(LC_DILITHIUM_65)) {

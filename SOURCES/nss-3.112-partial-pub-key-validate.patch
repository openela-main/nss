+    if (res == MP_NOT_POWER) {
+        /* xp = z */
+        MP_CHECKOK(mp_copy(&z, &xp));
+        /* z = z^2 (mod a) */
+        MP_CHECKOK(mp_sqrmod(&z, a, &z));
+        /* if z != 1 xp=z */
+        if (mp_cmp_d(&z, 1) != 0) {
+            MP_CHECKOK(mp_copy(&z, &xp));
+        }
+    }
+    res = MP_NOT_POWER;
+
+    /*  g = GCD(xp-1,a) */
+    MP_CHECKOK(mp_sub_d(&xp, 1, &xp));
+    MP_CHECKOK(mp_gcd(&xp, a, &g));
+    /* if g > 1 , copy g-> factor, return MP_COMPOSITE */
+    if (mp_cmp_d(&g, 1) > 0) {
+        if (factor) {
+            mp_copy(&g, factor);
+        }
+        res = MP_COMPOSITE;
+        goto CLEANUP;
+    }
+    res = MP_NOT_POWER;
+
+CLEANUP:
+    mp_clear(&m);
+    mp_clear(&z);
+    mp_clear(&g);
+    mp_clear(&xp);
+    mp_clear(&x);
+    mp_clear(&amo);
+    return res;
+
+} /* end mpp_pprime() */

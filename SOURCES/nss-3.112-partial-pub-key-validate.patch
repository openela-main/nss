+    MP_DIGITS(&e) = 0;
+    MP_DIGITS(&fact) = 0;
+    MP_DIGITS(&small_primes_product) = 0;
+    CHECK_MPI_OK(mp_init(&n));
+    CHECK_MPI_OK(mp_init(&e));
+    CHECK_MPI_OK(mp_init(&small_primes_product));
+    CHECK_MPI_OK(mp_init(&fact));

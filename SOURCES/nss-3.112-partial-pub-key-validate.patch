+        res = MP_NOT_POWER; /* just in case the following for loop never executes. */
+        for (jx = 1; jx < b; jx++) {
+            /* xp = z */
+            MP_CHECKOK(mp_copy(&z, &xp));
+            /* z = z^2 (mod a) */
+            MP_CHECKOK(mp_sqrmod(&z, a, &z));
+            res = MP_NOT_POWER; /* previous line set res to MP_PRIME */
+
+            if (mp_cmp_d(&z, 1) == 0) {
+                res = MP_COMPOSITE;
+                break;
+            }
+            if (mp_cmp(&z, &amo) == 0) {
+                res = MP_PRIME;
+                break;
+            }

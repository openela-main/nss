+                              primes_product_decimal_string, 10));
+    CHECK_MPI_OK(mp_gcd(&n,&small_primes_product, &fact));
+    if (mp_cmp_d(&fact, 1) != 0) {
+        /* factor found, not a good modulus */
+        err = MP_BADARG;
+        goto cleanup;
+    }
